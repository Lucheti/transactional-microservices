# Copy to .env for local (non-docker) runs. docker-compose sets these itself.

# NATS
NATS_SERVERS=nats://localhost:4222
NATS_REQUEST_TIMEOUT_MS=5000

# Redis (cache-aside layer — used by services that cache)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# Postgres (one instance, database-per-service)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=beta
DB_PASSWORD=beta
DB_SYNCHRONIZE=true
# One DB name per service. The orchestrator uses this one; add more as you add services.
SAGA_DB_NAME=beta_saga

# Gateway
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Enables POST /api/dev/token. NEVER enable in production.
DEV_TOKEN_ENDPOINT_ENABLED=true
